{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "umkm-cms",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // ===================== PRODUKSI (default `wrangler deploy`) =====================
  // CMS: https://cms.rela.my.id — situs pelanggan: https://web.rela.my.id/<slug>/
  "workers_dev": false,
  "routes": [{ "pattern": "cms.rela.my.id", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "umkm-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../migrations" }
  ],
  "r2_buckets": [
    { "binding": "SITES", "bucket_name": "umkm-sites" },
    { "binding": "MEDIA", "bucket_name": "umkm-media" }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ROOT_DOMAIN": "web.rela.my.id",
    "CMS_ORIGIN": "https://cms.rela.my.id",
    "MEDIA_ORIGIN": "https://media.rela.my.id",
    "SITE_URL_PATTERN": "https://web.rela.my.id/{slug}/",
    "BRAND_URL": "https://web.rela.my.id",
    "BRAND_NAME": "DomainKu",
    "PBKDF2_ITER": "100000",
    "HOSTING_PRICE_IDR": "100000",
    "PAYMENT_INFO": "",
    "ADMIN_WA": "",
    "TURNSTILE_SITE_KEY": "GANTI_DENGAN_SITE_KEY_TURNSTILE",
    "ZONE_ID": "175cbe991c9e8e9486b04f2dc935a643"
  },
  // Backup bertahap & pembersihan: setiap jam di menit ke-17.
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true },

  "env": {
    // ===================== STAGING di workers.dev (tanpa domain) =====================
    // SUBDOMAIN diisi otomatis oleh scripts/setup-cloudflare.mjs --staging
    "staging": {
      "workers_dev": true,
      "routes": [],
      "d1_databases": [
        { "binding": "DB", "database_name": "umkm-db-staging", "database_id": "451989a5-6f56-4c20-b035-5d7f7925a3ce", "migrations_dir": "../../migrations" }
      ],
      "r2_buckets": [
        { "binding": "SITES", "bucket_name": "umkm-sites-staging" },
        { "binding": "MEDIA", "bucket_name": "umkm-media-staging" }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "ROOT_DOMAIN": "web.rela.my.id",
        "BRAND_URL": "https://umkm-site-staging.haritrisna.workers.dev",
        "CMS_ORIGIN": "https://umkm-cms-staging.haritrisna.workers.dev",
        "MEDIA_ORIGIN": "https://umkm-cms-staging.haritrisna.workers.dev/api/_dev/media",
        "SITE_URL_PATTERN": "https://umkm-site-staging.haritrisna.workers.dev/{slug}/",
        "BRAND_NAME": "DomainKu",
        "PBKDF2_ITER": "100000",
        "HOSTING_PRICE_IDR": "100000",
        "PAYMENT_INFO": "",
        "ADMIN_WA": "",
        // Kunci uji Turnstile (selalu lolos) — staging hanya berisi data uji.
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "ZONE_ID": ""
      },
      "triggers": { "crons": ["17 * * * *"] }
    },
    // ===================== PENGEMBANGAN LOKAL (`wrangler dev --env dev`) =====================
    "dev": {
      "workers_dev": true,
      "routes": [],
      "d1_databases": [
        { "binding": "DB", "database_name": "umkm-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../migrations" }
      ],
      "r2_buckets": [
        { "binding": "SITES", "bucket_name": "umkm-sites" },
        { "binding": "MEDIA", "bucket_name": "umkm-media" }
      ],
      "vars": {
        "ENVIRONMENT": "development",
        "ROOT_DOMAIN": "domainku.id",
        "CMS_ORIGIN": "http://localhost:8787",
        "MEDIA_ORIGIN": "http://localhost:8787/api/_dev/media",
        "BRAND_NAME": "DomainKu",
        "PBKDF2_ITER": "100000",
        "HOSTING_PRICE_IDR": "100000",
        "PAYMENT_INFO": "",
        "ADMIN_WA": "",
        // Situs pelanggan lokal: http://localhost:8788/<slug>/
        "SITE_URL_PATTERN": "http://localhost:8788/{slug}/",
        "BRAND_URL": "http://localhost:8788",
        // Kunci uji resmi Turnstile (selalu lolos).
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "ZONE_ID": ""
      },
      "triggers": { "crons": [] }
    }
  }
}
