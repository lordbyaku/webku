{
  "name": "cms-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --persist-to ../../.wrangler/state",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply umkm-db --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply umkm-db --remote"
  },
  "dependencies": {
    "@umkm/shared": "*",
    "@umkm/content-schema": "*",
    "@umkm/templates": "*",
    "hono": "^4.7.0"
  }
}
